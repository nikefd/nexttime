/* Articles */
"article.whatIsKegel.intro" = "Kegel exercises are simple clench-and-release exercises that strengthen the pelvic floor muscles, which support the uterus, bladder, small intestine, and rectum.";
"article.whatIsKegel.origin.title" = "Origin";
"article.whatIsKegel.origin.content" = "These exercises were developed by Dr. Arnold Kegel in the late 1940s as a non-surgical treatment for urinary incontinence.";
"article.whatIsKegel.muscles.title" = "Target Muscles";
"article.whatIsKegel.muscles.content" = "The pelvic floor muscles are like a hammock stretching from the pubic bone to the tailbone. These muscles support your pelvic organs and control bladder and bowel function.";

"article.benefits.intro" = "Regular Kegel exercises can provide many benefits for both men and women:";
"article.benefits.1.title" = "Better Bladder Control";
"article.benefits.1.desc" = "Strengthening pelvic floor muscles can help prevent urinary incontinence.";
"article.benefits.2.title" = "Improved Core Stability";
"article.benefits.2.desc" = "A strong pelvic floor contributes to overall core strength and posture.";
"article.benefits.3.title" = "Enhanced Intimacy";
"article.benefits.3.desc" = "Stronger pelvic muscles can improve sensation and satisfaction.";
"article.benefits.4.title" = "Post-Pregnancy Recovery";
"article.benefits.4.desc" = "Helps restore muscle tone after childbirth.";
"article.benefits.5.title" = "Prostate Health";
"article.benefits.5.desc" = "For men, can help manage symptoms after prostate surgery.";

"article.howTo.intro" = "Follow these steps to perform Kegel exercises correctly:";
"article.howTo.step1.title" = "Find Your Muscles";
"article.howTo.step1.content" = "Imagine you're trying to stop urinating midstream or prevent passing gas. The muscles you use are your pelvic floor muscles.";
"article.howTo.step2.title" = "Contract";
"article.howTo.step2.content" = "Tighten your pelvic floor muscles and hold the contraction. Keep your breathing normal.";
"article.howTo.step3.title" = "Relax";
"article.howTo.step3.content" = "Release the muscles completely. Rest before the next contraction.";
"article.howTo.step4.title" = "Repeat";
"article.howTo.step4.content" = "Aim for 10-15 repetitions, 3 times daily. Gradually increase hold time as muscles strengthen.";

"article.faq.1.q" = "How long until I see results?";
"article.faq.1.a" = "Most people notice improvement within 4-6 weeks of regular practice. Full benefits may take 3-6 months.";
"article.faq.2.q" = "Can I do Kegels while doing other activities?";
"article.faq.2.a" = "Yes! Once you've mastered the technique, you can do Kegels while sitting, standing, or even walking.";
"article.faq.3.q" = "Can men do Kegel exercises?";
"article.faq.3.a" = "Absolutely! Men can benefit from Kegels for bladder control and prostate health.";
"article.faq.4.q" = "How do I know if I'm doing them correctly?";
"article.faq.4.a" = "You should feel a squeezing sensation. Your stomach, buttocks, and thighs should stay relaxed.";

"article.tips.intro" = "Get the most from your practice with these tips:";
"article.tips.1" = "Practice at the same time each day to build a habit";
"article.tips.2" = "Try different positions: sitting, lying down, or standing";
"article.tips.3" = "Don't hold your breath - keep breathing normally";
"article.tips.4" = "Focus on the pelvic floor only - don't tighten abs or buttocks";
"article.tips.5" = "Be patient - strength builds gradually over weeks";

