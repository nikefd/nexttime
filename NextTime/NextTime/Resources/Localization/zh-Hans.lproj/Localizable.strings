/* Articles */
"article.whatIsKegel.intro" = "凯格尔运动是简单的收缩-放松练习，可以增强盆底肌肉。这些肌肉支撑着子宫、膀胱、小肠和直肠。";
"article.whatIsKegel.origin.title" = "起源";
"article.whatIsKegel.origin.content" = "这些练习由阿诺德·凯格尔医生在20世纪40年代末开发，作为尿失禁的非手术治疗方法。";
"article.whatIsKegel.muscles.title" = "目标肌肉";
"article.whatIsKegel.muscles.content" = "盆底肌像一张吊床，从耻骨延伸到尾骨。这些肌肉支撑着盆腔器官，控制膀胱和肠道功能。";

"article.benefits.intro" = "定期进行凯格尔运动可以为男性和女性带来多种好处：";
"article.benefits.1.title" = "更好的膀胱控制";
"article.benefits.1.desc" = "增强盆底肌可以帮助预防尿失禁。";
"article.benefits.2.title" = "改善核心稳定性";
"article.benefits.2.desc" = "强壮的盆底有助于整体核心力量和姿势。";
"article.benefits.3.title" = "提升亲密体验";
"article.benefits.3.desc" = "更强的盆底肌可以改善感觉和满足感。";
"article.benefits.4.title" = "产后恢复";
"article.benefits.4.desc" = "帮助分娩后恢复肌肉张力。";
"article.benefits.5.title" = "前列腺健康";
"article.benefits.5.desc" = "对于男性，可以帮助管理前列腺手术后的症状。";

"article.howTo.intro" = "按照以下步骤正确进行凯格尔运动：";
"article.howTo.step1.title" = "找到肌肉";
"article.howTo.step1.content" = "想象你正在中途停止排尿或阻止放屁。你使用的肌肉就是盆底肌。";
"article.howTo.step2.title" = "收缩";
"article.howTo.step2.content" = "收紧盆底肌并保持收缩。保持正常呼吸。";
"article.howTo.step3.title" = "放松";
"article.howTo.step3.content" = "完全放松肌肉。在下一次收缩前休息。";
"article.howTo.step4.title" = "重复";
"article.howTo.step4.content" = "目标是每次10-15次重复，每天3次。随着肌肉增强，逐渐增加保持时间。";

"article.faq.1.q" = "多久能看到效果？";
"article.faq.1.a" = "大多数人在规律练习4-6周内会注意到改善。完全的效果可能需要3-6个月。";
"article.faq.2.q" = "可以边做其他事边做凯格尔运动吗？";
"article.faq.2.a" = "可以！一旦掌握了技巧，你可以在坐着、站着甚至走路时做凯格尔运动。";
"article.faq.3.q" = "男性可以做凯格尔运动吗？";
"article.faq.3.a" = "当然可以！男性可以从凯格尔运动中获得膀胱控制和前列腺健康方面的好处。";
"article.faq.4.q" = "怎么知道做对了？";
"article.faq.4.a" = "你应该感到挤压感。你的腹部、臀部和大腿应该保持放松。";

"article.tips.intro" = "通过这些提示让你的练习更有效：";
"article.tips.1" = "每天在固定时间练习，养成习惯";
"article.tips.2" = "尝试不同姿势：坐着、躺着或站着";
"article.tips.3" = "不要憋气 - 保持正常呼吸";
"article.tips.4" = "只收紧盆底肌 - 不要收紧腹部或臀部";
"article.tips.5" = "要有耐心 - 力量会在几周内逐渐增强";

