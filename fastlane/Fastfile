require "json"

default_platform(:ios)

PROJECT = "NextTime/NextTime.xcodeproj"
SCHEME = "NextTime"
APP_IDENTIFIER = ENV.fetch("APP_IDENTIFIER", "com.zhangyangbin.NextTime")
TEAM_ID = ENV.fetch("APPLE_TEAM_ID", "V59XFX9635")

def app_store_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: true
  )
end

def available_iphone_destination
  devices = JSON.parse(`xcrun simctl list devices available --json`).fetch("devices").values.flatten
  iphone = devices.find { |device| device["name"].start_with?("iPhone") && device["isAvailable"] }
  UI.user_error!("No available iPhone simulator was found") unless iphone
  "platform=iOS Simulator,id=#{iphone.fetch("udid")}"
end

def store_metadata_value(filename)
  path = File.expand_path("store_metadata/zh-Hans/#{filename}", __dir__)
  File.read(path, encoding: "UTF-8").strip
end

platform :ios do
  desc "Create or repair the encrypted App Store signing assets in Match"
  lane :bootstrap_signing do
    api_key = app_store_api_key
    match(
      type: "appstore",
      readonly: false,
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: TEAM_ID,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_private_key: ENV.fetch("MATCH_GIT_PRIVATE_KEY_PATH")
    )
  end

  desc "Run unit and UI tests on an available iPhone simulator"
  lane :test do
    scan(
      project: PROJECT,
      scheme: SCHEME,
      destination: available_iphone_destination,
      clean: true,
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      output_types: "junit",
      output_files: "tests.xml"
    )
  end

  private_lane :prepare_release do |options|
    api_key = options.fetch(:api_key)
    version = ENV["APP_VERSION"]

    increment_version_number(xcodeproj: PROJECT, version_number: version) if version && !version.empty?
    version ||= get_version_number(xcodeproj: PROJECT, target: SCHEME)

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    ) + 1
    increment_build_number(xcodeproj: PROJECT, build_number: build_number)

    setup_ci if ENV["CI"]
    match(
      type: "appstore",
      readonly: ENV["CI"] == "true",
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: TEAM_ID,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_private_key: ENV.fetch("MATCH_GIT_PRIVATE_KEY_PATH")
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      clean: true,
      export_method: "app-store",
      xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number} CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{TEAM_ID} CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='match AppStore #{APP_IDENTIFIER}'",
      output_directory: "artifacts",
      output_name: "NextTime-#{version}-#{build_number}.ipa"
    )
  end

  desc "Build, sign, and upload the next build to TestFlight"
  lane :beta do
    api_key = app_store_api_key
    prepare_release(api_key: api_key)
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      changelog: ENV["RELEASE_NOTES"],
      distribute_external: false,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Update editable metadata on the live App Store product page"
  lane :store_metadata do
    api_key = app_store_api_key
    locale = "zh-Hans"

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      edit_live: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
      description: { locale => store_metadata_value("description.txt") },
      promotional_text: { locale => store_metadata_value("promotional_text.txt") },
      support_url: { locale => store_metadata_value("support_url.txt") },
      marketing_url: { locale => store_metadata_value("marketing_url.txt") },
      privacy_url: { locale => store_metadata_value("privacy_url.txt") }
    )
  end

  desc "Build, submit for App Review, and release automatically after approval"
  lane :release do
    UI.user_error!("APP_VERSION is required for an App Store release") if ENV["APP_VERSION"].to_s.empty?

    api_key = app_store_api_key
    locale = "zh-Hans"
    prepare_release(api_key: api_key)
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: ENV.fetch("APP_VERSION"),
      release_notes: {
        locale => ENV.fetch("APP_STORE_RELEASE_NOTES_ZH")
      },
      description: { locale => store_metadata_value("description.txt") },
      subtitle: { locale => store_metadata_value("subtitle.txt") },
      keywords: { locale => store_metadata_value("keywords.txt") },
      promotional_text: { locale => store_metadata_value("promotional_text.txt") },
      support_url: { locale => store_metadata_value("support_url.txt") },
      marketing_url: { locale => store_metadata_value("marketing_url.txt") },
      privacy_url: { locale => store_metadata_value("privacy_url.txt") },
      primary_category: "Health & Fitness",
      secondary_category: "Utilities",
      screenshots_path: File.expand_path("screenshots", __dir__),
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end

